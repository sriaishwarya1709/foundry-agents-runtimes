// Run one block at a time in Application Insights component Logs, not workspace Logs.
// These queries read existing telemetry; they do not invoke agents. Allow for ingestion delay.
// 1. Custom spans: technical success and business invoice status are different fields.
dependencies
| where timestamp > ago(1h)
| where name in ("check_invoice", "invoice.batch", "batch.invoice", "batch.report", "batch.model_summary")
| project timestamp, name, duration, success, operation_Id,
    invoice=tostring(customDimensions["invoice.id"]),
    status=tostring(customDimensions["invoice.status"]),
    job=tostring(customDimensions["job.id"]),
    checkpoint_reused=tostring(customDimensions["checkpoint.reused"]),
    platform_recovery=tostring(customDimensions["batch.recovery"]),
    report_created=tostring(customDimensions["report.created"])
| order by timestamp desc

// 2. Latency: p95 is the duration at or below which about 95% of observed calls completed.
dependencies
| where timestamp > ago(1h)
| where name in ("check_invoice", "invoice.batch", "batch.model_summary")
| summarize calls=count(), average=avg(duration), p95=percentile(duration, 95) by name

// 3. Application log messages; exported spans and log messages are separate telemetry.
traces
| where timestamp > ago(1h)
| where message has "check_invoice"
    or message contains "Verification unavailable"
    or message contains "Batch progress"
    or message contains "Hosted batch job="
    or message contains "Rejected invalid invoice identifier"
| project timestamp, severityLevel, message, operation_Id
| order by timestamp desc
